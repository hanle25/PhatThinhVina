# backend/.env — copy to .env and fill in
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
GOOGLE_API_KEY=

# frontend/.env — copy to frontend/.env and fill in
REACT_APP_API_URL_CUSTOMERS=http://localhost:5000/customers
REACT_APP_API_URL_STORAGES=http://localhost:5000/storages
REACT_APP_API_URL_CATALOGS=http://localhost:5000/catalogs
REACT_APP_API_ASSIGN_TRUCKS=http://localhost:5000/assign_trucks
